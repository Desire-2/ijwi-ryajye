# ---- Core ----
FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg2://ijwi:ijwi_dev@127.0.0.1:5433/ijwi_ryajye

# ---- JWT ----
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# ---- Realtime / workers ----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
SOCKET_MESSAGE_QUEUE=memory://          # use redis:// in multi-process deployments

# ---- SMS (OTP + notifications). "mock" logs codes to stdout. ----
SMS_PROVIDER=mock
SMS_SENDER_ID=IJWI
# Africa's Talking (optional)
AT_USERNAME=
AT_API_KEY=

# ---- Payments. Providers are enabled as "<name>:<webhook_secret>" pairs. ----
PAYMENT_PROVIDERS=mock:dev-webhook-secret
PAYMENT_WEBHOOK_SECRETS=mock:dev-webhook-secret

# ---- Platform economics (percent, e.g. 2.5 = 2.5%) ----
PLATFORM_FEE_PERCENT=2.5
ESCROW_CLEARANCE_HOURS=48

# ---- Storage (local dev uses ./storage; production: s3) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Intelligence ----
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=
AI_RATE_LIMIT=20 per hour
